{
  "name": "SquanGo CSP",
  "short_name": "CSP",
  "start_url": "./",
  "scope": "./",
  "id": "./manifest.webmanifest",
  "display": "standalone",
  "background_color": "#f5f5f5",
  "theme_color": "#e3f2fd",
  "description": "Learn, train, and manage your CSPs, all in one place.",
  "icons": [
    {
      "src": "./favicon.ico",
      "sizes": "16x16 32x32",
      "type": "image/x-icon"
    },
    {
      "src": "./res/icons/icon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "./res/icons/icon-16.png",
      "sizes": "16x16",
      "type": "image/png"
    }
  ]
}
